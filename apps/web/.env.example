# Conta e sincronização (Supabase). Sem estas duas, o app funciona só no celular.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cobrança (Asaas) — só no servidor. Sem elas, "Assinar" avisa que a cobrança ainda não está disponível.
ASAAS_API_KEY=
# https://api-sandbox.asaas.com/v3 para testes; https://api.asaas.com/v3 em produção
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token que você define no painel do Asaas para o webhook (cabeçalho asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# Chave service_role do Supabase: o webhook usa para gravar a assinatura (nunca vai para o navegador)
SUPABASE_SERVICE_ROLE_KEY=
